<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Authors>TryPhotino</Authors>
		<Company>TryPhotino</Company>
		<Description>.NET 8/9 app that opens native OS windows hosting web UI on Windows, Mac, and Linux (without Blazor support)</Description>
		<GenerateNuspecDependsOn>$(GenerateNuspecDependsOn);SetPackageVersion</GenerateNuspecDependsOn>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<PackageDescription>.NET 8/9 app that opens native OS windows hosting web UI on Windows, Mac, and Linux (without Blazor support)</PackageDescription>
		<PackageId>Photino.NET</PackageId>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<Product>Photino.NET</Product>
		<PackageProjectUrl>https://github.com/tryphotino/photino.NET</PackageProjectUrl>
		<RepositoryUrl>https://github.com/tryphotino/photino.NET</RepositoryUrl>
		<Title>Photino.NET</Title>
		<RootNamespace>Photino.NET</RootNamespace>
	</PropertyGroup>

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0</TargetFrameworks>
		<ImplicitUsings>true</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<OutputType>Library</OutputType>
		<IsPackable>true</IsPackable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Copyright>Copyright (C) 2025</Copyright>
	</PropertyGroup>

	<PropertyGroup>
		<PhotinoNativeWinPlatform Condition="'$(PhotinoNativeWinPlatform)' == ''">x64</PhotinoNativeWinPlatform>
		<PhotinoNativeWinPlatform Condition="$(RuntimeIdentifier.StartsWith('win-arm64'))">ARM64</PhotinoNativeWinPlatform>
		<PhotinoNativeWinDir>$(MSBuildThisFileDirectory)..\Photino.Native\Photino.Native\$(PhotinoNativeWinPlatform)\Release\</PhotinoNativeWinDir>
		<PhotinoNativeWinDll>$(PhotinoNativeWinDir)Photino.Native.dll</PhotinoNativeWinDll>
		<PhotinoUseForkNative Condition="'$(PhotinoUseForkNative)' == '' and Exists('$(PhotinoNativeWinDll)') and ($(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))))">true</PhotinoUseForkNative>
	</PropertyGroup>

	<Target Name="SetPackageVersion" DependsOnTargets="Build">
		<PropertyGroup>
			<PackageVersion>$(Version)</PackageVersion>
		</PropertyGroup>
	</Target>

	<ItemGroup Condition="'$(PhotinoUseForkNative)' == 'true'">
		<PackageReference Include="Photino.Native" Version="4.0.22" ExcludeAssets="native" />
		<None Include="$(PhotinoNativeWinDll)" Link="Photino.Native.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
		<None Include="$(PhotinoNativeWinDir)WebView2Loader.dll" Link="WebView2Loader.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
	</ItemGroup>

	<ItemGroup Condition="'$(PhotinoUseForkNative)' != 'true'">
		<PackageReference Include="Photino.Native" Version="4.0.22" />
	</ItemGroup>

	<Target Name="PhotinoBuildForkNative" BeforeTargets="BeforeBuild;ResolvePackageAssets" Condition="'$(PhotinoUseForkNative)' != 'true' and $([MSBuild]::IsOSPlatform('Windows')) and !$(RuntimeIdentifier.StartsWith('osx')) and !$(RuntimeIdentifier.StartsWith('linux')) and Exists('$(MSBuildThisFileDirectory)..uild-native.cmd')">
		<Exec Command="&quot;$(MSBuildThisFileDirectory)..uild-native.cmd&quot; $(PhotinoNativeWinPlatform)" ContinueOnError="true" />
	</Target>

	<Target Name="PhotinoWarnMissingForkNative" BeforeTargets="Build" Condition="!Exists('$(PhotinoNativeWinDll)') and $([MSBuild]::IsOSPlatform('Windows')) and !$(RuntimeIdentifier.StartsWith('osx')) and !$(RuntimeIdentifier.StartsWith('linux'))">
		<Warning Text="Photino fork: native Windows build not found at $(PhotinoNativeWinDll). Falling back to the Photino.Native NuGet binary; CompositionHosting, surfaces and resource suspension are unavailable. Run build-native.cmd in the fork root." />
	</Target>

</Project>
